# Copy to .env for local development. Never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
TIME_ZONE=Asia/Kolkata

# Google Meet integration is optional. Configure Google Calendar API + OAuth first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback/
GOOGLE_CALENDAR_ID=primary

# Email SMTP (optional; if omitted, emails print to the local terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MediConnect <noreply@example.com>

# Razorpay test/live keys. Never commit real credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
